# Same Supabase project as apps/web (docs/authentication.md). Publishable key only.
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...


# E2E (pnpm --filter admin test:e2e): staff accounts that already exist in the project.
# Without them the signed-in specs skip. Read from this file's .env.local by playwright.config.ts.
E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
